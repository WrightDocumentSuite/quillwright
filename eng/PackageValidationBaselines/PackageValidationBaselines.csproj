<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <!-- The baseline version is selected per release; keep its generated lock outside source. -->
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)../../artifacts/release-locks/PackageValidationBaselines.packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <!--
    Package validation resolves baselines from the global packages folder but does not restore
    them itself. PackageDownload keeps the release gate self-contained on a clean machine.
  -->
  <ItemGroup Condition="'$(BaselineVersion)' != ''">
    <PackageDownload Include="Quillwright" Version="[$(BaselineVersion)]" />
    <PackageDownload Include="Quillwright.Doc" Version="[$(BaselineVersion)]" />
    <PackageDownload Include="Quillwright.Pdf" Version="[$(BaselineVersion)]" />
    <PackageDownload Include="Quillwright.Rtf" Version="[$(BaselineVersion)]" />
    <PackageDownload Include="Quillwright.Templates" Version="[$(BaselineVersion)]" />
  </ItemGroup>

  <Target Name="RequireBaselineVersion" BeforeTargets="Restore">
    <Error Condition="'$(BaselineVersion)' == ''"
           Text="Set BaselineVersion through eng/restore-package-baselines.ps1." />
  </Target>

</Project>
