<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Quillwright.Pdf.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>Quillwright.Pdf</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Quillwright.Pdf</PackageId>
    <Description>Renders Quillwright Word documents to PDF: pagination of text, tables, lists, sections, headers and footers on top of Inkwright. No Office and no native dependency.</Description>
    <PackageTags>word;docx;pdf;conversion;export;pagination</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quillwright\Quillwright.csproj" />
    <PackageReference Include="Inkwright" />
    <!--
      Not used directly. Inkwright 0.1.3 accepts Pkcs 10.0.0, which has known vulnerabilities;
      a dependency of this package raises the floor for every consumer. With PrivateAssets it
      would stay out of the nuspec and protect only this build.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
