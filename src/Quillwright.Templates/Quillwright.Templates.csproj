<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Quillwright.Templates.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>Quillwright.Templates</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Quillwright.Templates</PackageId>
    <Description>Typed Word templating for Quillwright: fill content controls, {{placeholders}} and MERGEFIELDs from a model, repeat table rows over collections, all through an incremental source generator with no reflection.</Description>
    <PackageTags>word;docx;template;mailmerge;sourcegenerator;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quillwright\Quillwright.csproj" />
    <ProjectReference Include="..\Quillwright.Templates.Generator\Quillwright.Templates.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Ship the generator inside this package. It is collected in a target rather than in a plain
    ItemGroup because an ItemGroup is evaluated before anything is built: on a tree with no
    artifacts/ yet, an Exists() condition there is false, and `dotnet pack` produces a package
    that installs and then silently generates nothing. Inside a target that runs as pack
    gathers its files, the build has already happened and the assembly is there.

    Resolve the generator ProjectReference's target path explicitly, so it stays correct whatever
    UseArtifactsOutput does with the output directory. Pack does not resolve project-reference
    outputs when NoBuild=true; in that mode @(Analyzer) contains only the SDK analyzers.
  -->
  <Target Name="PackTheGenerator"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="PrepareProjectReferences">
    <ItemGroup>
      <_TemplateGeneratorProject Include="@(_MSBuildProjectReferenceExistent)"
                                 Condition="'%(Filename)' == 'Quillwright.Templates.Generator'" />
    </ItemGroup>

    <Error Condition="'@(_TemplateGeneratorProject)' == ''"
           Text="The Quillwright.Templates.Generator project reference could not be resolved, so this package would ship without its source generator." />

    <MSBuild Projects="@(_TemplateGeneratorProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_TemplateGeneratorProject.SetConfiguration); %(_TemplateGeneratorProject.SetPlatform); %(_TemplateGeneratorProject.SetTargetFramework)"
             RemoveProperties="%(_TemplateGeneratorProject.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'@(_TemplateGeneratorProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_TemplateGenerator" />
    </MSBuild>

    <ItemGroup>
      <None Include="@(_TemplateGenerator)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>

    <Error Condition="'@(_TemplateGenerator)' == ''"
           Text="Quillwright.Templates.Generator did not report an output assembly, so this package would ship without its source generator." />
    <Error Condition="'@(_TemplateGenerator)' != '' and !Exists('%(_TemplateGenerator.Identity)')"
           Text="Quillwright.Templates.Generator was resolved to '%(_TemplateGenerator.Identity)', but the assembly does not exist. Build the generator project before packing Quillwright.Templates." />
  </Target>

</Project>
